# ==============================================================================
# Copilot CRM - Configuração de Provedores de IA via .env
# ==============================================================================
# Este arquivo pode ficar localizado em:
# 1) /home/bernardo/frappe/my-bench/.env (Recomendado para o bench inteiro)
# 2) /home/bernardo/frappe/my-bench/sites/crm.localhost/.env (Específico do site)
# 3) /home/bernardo/repos/copilot_crm/.env
# ==============================================================================

# Opção 1: Configuração Genérica do Copilot (LiteLLM model ID)
# Exemplos:
# - OpenAI: openai/gpt-4o ou openai/gpt-4o-mini
# - Anthropic: anthropic/claude-3-5-sonnet-20241022
# - OpenRouter: openrouter/anthropic/claude-3.5-sonnet ou openrouter/openai/gpt-4o
# - Groq: groq/llama-3.3-70b-versatile
# - Gemini: gemini/gemini-2.0-flash
# - Local (Ollama): ollama/llama3.2 (informar COPILOT_AI_BASE_URL=http://localhost:11434)
COPILOT_AI_MODEL=openai/gpt-4o-mini
COPILOT_AI_API_KEY=sk-proj-sua-chave-aqui
# COPILOT_AI_BASE_URL=https://api.openai.com/v1

# Opção 2: Chaves Padrão de Provedores (o Copilot detecta automaticamente se COPILOT_AI_API_KEY não estiver definido)
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIzaSy...

# Qdrant (Memória Semântica / RAG para transcrições e reuniões)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=crm_knowledge
# QDRANT_API_KEY=
